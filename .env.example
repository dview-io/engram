# Postgres with the `vector` (pgvector) extension installed.
# Used by Phase 2 integration tests (`tests/phase2_postgres.rs`).
#
# Only ENGRAM_DATABASE_URL is read (never generic DATABASE_URL).
# Each test creates/drops its own schema `engram_test_<uuid>`.
#
# sqlx form:
ENGRAM_DATABASE_URL=postgres://root:strong_password@localhost:5441/postgres
#
# SQLAlchemy-style URIs are accepted (`+psycopg2` is stripped):
# ENGRAM_DATABASE_URL=postgresql+psycopg2://root:strong_password@localhost:5441/postgres
#
# Fail (don't skip) when URL is missing — set this in CI:
# ENGRAM_REQUIRE_DB=1
#
# ENGRAM_EMBEDDING_DIM=32
